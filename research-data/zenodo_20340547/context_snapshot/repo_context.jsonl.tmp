iggers": {"schedule": [{"cron": "30 1 * * *"}], "workflow_dispatch": null}}, {"has_build_test_lint_hint": false, "jobs": ["notify"], "path": ".github/workflows/notify_release.yml", "review": ["SECRET_REFERENCE"], "triggers": {"release": {"types": ["released"]}}}, {"has_build_test_lint_hint": true, "jobs": ["check"], "path": ".github/workflows/release_block_manual_pr.yml", "review": ["SECRET_REFERENCE"], "triggers": {"pull_request": {"branches": ["release"]}}}, {"has_build_test_lint_hint": false, "jobs": ["release-doc"], "path": ".github/workflows/release_doc.yml", "review": ["SECRET_REFERENCE"], "triggers": {"workflow_dispatch": null}}, {"has_build_test_lint_hint": false, "jobs": ["release"], "path": ".github/workflows/release_kickoff.yml", "review": ["SECRET_REFERENCE"], "triggers": {"workflow_dispatch": null}}, {"has_build_test_lint_hint": true, "jobs": ["integration-tests"], "path": ".github/workflows/run_integration_tests.yml", "review": ["SECRET_REFERENCE"], "triggers": {"workflow_call": {"inputs": {"allowed_skips": {"default": 0, "description": "With enforce_no_skips, the most tests the last test run may skip.", "required": false, "type": "number"}, "cognito_client_ci_overlay": {"default": "", "description": "Space-separated Cognito client roles (email-alias, extended) to give the client's own CI resources, which CI downloads into the auth configuration's cognito-client-ci/ subfolder (AmplifyClients/AmplifyCognitoClient/Tests/IntegrationTests/infra/ci). The build then reads a directory of its own (COGNITO_CLIENT_INTEG_DIR); the downloaded files are not changed. Empty, or no subfolder, changes nothing. Only the client jobs set it.", "required": false, "type": "string"}, "cognito_client_integ_ci_skips": {"default": "", "description": "Set to 1 to give the test process COGNITO_CLIENT_INTEG_CI_SKIPS=1 (as TEST_RUNNER_COGNITO_CLIENT_INTEG_CI_SKIPS), so the Cognito client suites skip on CI, naming the reason, the tests whose resource the plugin's CI does not provide. Empty sets nothing. No job in this repository sets it today: the client jobs get the client's own CI resources (cognito_client_ci_overlay) and fail on any skip (enforce_no_skips). It stays for a job that runs the client suites on the plugin's files alone. A local run sets TEST_RUNNER_COGNITO_CLIENT_INTEG_CI_SKIPS=1 in xcodebuild's environment itself.", "required": false, "type": "string"}, "destination": {"default": "", "type": "string"}, "enforce_no_skips": {"default": false, "description": "Fail the job when its last test run (the retry, when there was one) skipped more tests than allowed_skips, read from that run's result bundle (xcresulttool). Off by default; only the Cognito client jobs turn it on.", "required": false, "type": "boolean"}, "job_name_suffix": {"default": "", "required": false, "type": "string"}, "only_testing": {"default": "", "required": false, "type": "string"}, "os-runner": {"default": "macos-26", "type": "string"}, "platform": {"description": "The platform in which to run these tests", "required": true, "type": "string"}, "project_path": {"required": false, "type": "string"}, "resource_subfolder": {"required": true, "type": "string"}, "scheme": {"description": "The scheme to run the tests", "required": true, "type": "string"}, "test_iterations": {"default": 3, "description": "The -test-iterations of an unscoped run and of its retry. Each iteration after a failure runs the whole suite again.", "required": false, "type": "number"}, "timeout-minutes": {"default": 60, "description": "The timeout for each execution", "required": false, "type": "number"}, "uninstall_before_retry": {"default": "", "description": "Space-separated bundle IDs to uninstall from the simulator before the retry. Empty keeps it as it is.", "required": false, "type": "string"}, "xcode_version": {"default": "latest", "description": "The version of Xcode used to run these tests", "type": "string"}}}}}, {"has_build_test_lint_hint": true, "jobs": ["unit-tests"], "path": ".github/workflows/run_unit_tests.yml", "review": [], "triggers": {"workflow_call": {"inputs": {"generate_coverage_report": {"default": false, "description": "Whether to generate and report code coverage", "required": false, "type": "boolean"}, "os-runner": {"description": "runs-on input", "type": "string"}, "platform": {"description": "The platform in which to run these tests", "required": true, "type": "string"}, "project_path": {"required": false, "type": "string"}, "retry_tests": {"default": true, "required": false, "type": "boolean"}, "scheme": {"description": "The scheme to run the tests", "required": true, "type": "string"}, "test_iterations_flags": {"default": "-test-iterations 3 -retry-tests-on-failure -parallel-testing-enabled NO -test-repetition-relaunch-enabled YES", "description": "The xcodebuild flags used when running the test. Defaults to retrying on failure up to 3 times", "required": false, "type": "string"}, "timeout-minutes": {"default": 60, "description": "The timeout for each execution", "required": false, "type": "number"}, "xcode_version": {"default": "latest", "description": "The version of Xcode used to run these tests", "type": "string"}}}}}, {"has_build_test_lint_hint": true, "jobs": ["run-unit-tests"], "path": ".github/workflows/run_unit_tests_platforms.yml", "review": [], "triggers": {"workflow_call": {"inputs": {"generate_coverage_report": {"default": false, "description": "Whether to generate and report code coverage", "required": false, "type": "boolean"}, "os-runner": {"default": "macos-26", "description": "runs-on input", "type": "string"}, "platforms": {"default": "[\"iOS\", \"macOS\", \"tvOS\", \"watchOS\", \"visionOS\"]", "description": "JSON array of platforms to run. Defaults to all; callers pass a subset (e.g. PRs run iOS + macOS only).", "required": false, "type": "string"}, "retry_tests": {"default": true, "required": false, "type": "boolean"}, "scheme": {"description": "The scheme to run the tests", "required": true, "type": "st