g"}, "old_ref": {"default": "", "required": false, "type": "string"}, "rust_log": {"default": "info", "required": false, "type": "string"}, "test": {"default": "v141_rollout", "description": "Scenario or comma-separated scenarios", "required": false, "type": "string"}, "test_testing_fault": {"default": false, "description": "TEST ONLY: corrupt v141_rollout contributions or withhold the v141_mid_session candidate", "required": false, "type": "boolean"}, "use_mocks": {"default": false, "required": false, "type": "boolean"}}}, "workflow_dispatch": {"inputs": {"candidate_sha": {"default": "", "description": "Exact candidate SHA (empty = SHA captured when the run is dispatched)", "required": false, "type": "string"}, "epoch_duration_ms": {"default": "", "description": "Override ika genesis epoch duration in ms (v141_rollout requires >=480000, wedged_drain >=1680000; empty = scenario default)", "required": false, "type": "string"}, "heap_profile": {"default": false, "description": "Enable jemalloc heap profiling (jeprof) to find what holds validator memory — pair with ONE light scenario, e.g. test=workload", "required": false, "type": "boolean"}, "max_mpc_computation_cores": {"default": "", "description": "Cap each validator's concurrent dwallet-MPC computations (bounds peak memory for co-located test validators; empty = node default = host cores)", "required": false, "type": "string"}, "old_bin_name": {"default": "", "description": "OLD validator bin name (empty = ika-validator)", "required": false, "type": "string"}, "old_ref": {"default": "", "description": "Git ref/tag/sha for the OLD binary (empty = per-scenario default; v141_rollout uses release/mainnet-v1.4.1)", "required": false, "type": "string"}, "rust_log": {"default": "info", "description": "RUST_LOG for the harness + child validators (default info)", "required": false, "type": "string"}, "test": {"default": "all", "description": "Scenarios: 'all', or a comma-separated subset e.g. 'smoke,workload'. Each runs a