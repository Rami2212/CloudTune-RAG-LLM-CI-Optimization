, "description": "Query overrides", "options": ["", "sqlite", "postgresql", "mysql", "dremio", "odbc-athena", "odbc-databricks", "oracle", "duckdb", "duckdb-zero-results", "snowflake", "snowflake-catalog", "spark", "iceberg-sf1", "spicecloud-catalog", "glue-catalog", "databricks-catalog", "spicecloud", "iceberg-hadoop", "dynamodb", "arrow", "cayenne", "postgres-catalog", "mysql-catalog", "mssql-catalog", "oracle-catalog", "ducklake-catalog", "turso", "bigquery", "scylladb"], "required": false, "type": "choice"}, "query_set": {"default": "tpch", "description": "Query set", "options": ["tpch", "tpch[parameterized]", "tpcds", "clickbench", "chbench", "scenario"], "required": true, "type": "choice"}, "ready_wait": {"default": "30", "description": "How long (in seconds) to wait for spiced to start", "required": true, "type": "string"}, "runner_type": {"default": "spiceai-dev-runners", "description": "Runner type", "options": ["spiceai-dev-runners", "spiceai-dev-large-runners", "spiceai-dev-xlarge-runners"], "required": true, "type": "choice"}, "scale_factor": {"default": "1", "description": "Scale factor for the benchmark", "required": false, "type": "string"}, "scenario_query_file": {"default": "", "description": "Path to scenario query file (required when query_set is scenario)", "required": false, "type": "string"}, "spiced_commit": {"description": "spiced build commit", "required": false, "type": "string"}, "spiced_ref": {"default": "", "description": "Branch or tag whose spiced to benchmark, e.g. v2.1.0 or release/2.4; empty = trunk. A release tag uses that release's published binary. Ignored when spiced_commit is set", "required": false, "type": "string"}, "spicepod_path": {"description": "The spicepod file to test with", "required": true, "type": "string"}, "update_snapshots": {"default": "default", "description": "Update the snapshots?", "options": ["default", "always", "no"], "required": false, "type": "choice"}, "validate_results": {"default": false, "description": "Validate the results?", "required": false, "type": "boolean"}}}}}, {"has_build_test_lint_hint": true, "jobs": ["run-cluster-bench"], "path": ".github/workflows/testoperator_run_cluster_bench.yml", "review": ["SECRET_REFERENCE"], "triggers": {"workflow_dispatch": {"inputs": {"app_storage_size_gb": {"default": "", "description": "PVC size in GiB for the scheduler pod (/data)", "required": false, "type": "string"}, "cayenne_file_path": {"default": "", "description": "Cayenne file accelerator base path passed to spidapter (e.g. /data/cayenne)", "required": false, "type": "string"}, "cayenne_metadata_dir": {"default": "", "description": "Cayenne metadata directory passed to spidapter (e.g. /data/cayenne/metadata)", "required": false, "type": "string"}, "channel": {"default": "nightly", "description": "Spice runtime image channel passed to spidapter (ignored when custom_image_tag is set)", "options": ["nightly", "preview", "stable", "internal"], "required": true, "type": "choice"}, "cluster_name": {"default": "", "description": "Spice Cloud nodegroup name passed to spidapter as SPIDAPTER_CLUSTER_NAME\n(from GET /v1/clusters). Empty keeps the default regional shared stamp;\nset e.g. `spicehq-ballista` to pin apps onto that private nodegroup.\n", "required": false, "type": "string"}, "compute": {"default": "scp", "description": "Where the cluster runs. `scp` deploys a Spice Cloud app. `ec2` launches\na temporary scheduler and `executor_replicas` executor instances in the\nsandbox account for each image in `ec2_images`, and terminates them\nwhen that image's run ends.\n", "options": ["scp", "ec2"], "required": false, "type": "choice"}, "custom_image_tag": {"default": "", "description": "Custom runtime container image tag from `ghcr.io/spiceai/spiceai-dev`\n(e.g. `trunk-20260514.1055`, produced by the `spiced_docker_dev`\nworkflow). When set, overrides `channel` so the bench runs against a\nspecific spiced build instead of the published channel image. The\ncluster dispatch workflow sets this automatically after building the\ncommit-pinned image; set it manually only when running this workflow\ndirectly against a pre-built image.\n", "required": false, "type": "string"}, "dispatch_id": {"default": "", "description": "Optional unique ID from a parent dispatcher, used only to identify this run.", "required": false, "type": "string"}, "ec2_images": {"default": "", "description": "`compute: ec2` only. Comma-separated `spiced` images to run in order on\nidentical clusters, e.g. `spiceai/spiceai:2.3.2,spiceai/spiceai:2.4.0-rc.3`.\n", "required": false, "type": "string"}, "ephemeral_storage_limit": {"default": "", "description": "Pod ephemeral-storage limit passed to spidapter (e.g. 20Gi)", "required": false, "type": "string"}, "executor_replicas": {"default": "4", "description": "Number of spidapter executor replicas", "required": true, "type": "string"}, "executor_storage_size_gb": {"default": "", "description": "PVC size in GiB for executor pods (/data)", "required": false, "type": "string"}, "organization_tag": {"default": "spicehq", "description": "Organization tag applied to the spidapter app; selects the target nodegroup (empty = shared default nodegroup)", "required": false, "type": "string"}, "query_set": {"default": "tpch", "description": "Query set", "options": ["tpch", "tpch[parameterized]", "tpcds", "clickbench", "scenario"], "required": true, "type": "choice"}, "query_temp_directory": {"default": "", "description": "runtime.query.temp_directory passed to spidapter (for spill/local work files)", "required": false, "type": "string"}, "query_transport": {"default": "v1-queries", "description": "Which distributed path inside the cluster to exercise", "options": ["v1-queries", "flightsql"], "required": true, "type": "choice"}, "ready_wait": {"default": "600", "description": "Seconds to wait for the cluster to become ready", "required": true, "type": "string"}, "runner_type": {"default": "spiceai-dev-runners", "description": "Runner type", "options": ["spiceai-dev-runners", "spiceai-dev-large-runners"], "required": true, "type": "choice"}, "scale_factor": {"default": "1", "description": "Scale factor for the benchmark", "required": false, "type": "string"}, "scenario_query_file": {"default": "", "description": "Path to scenario query file (required when query_set is scenario)", "required": false, "type": "string"}, "shuffle_location": {"default": "", "description": "Ballista shuffle location passed to spidapter as SPIDAPTER_SHUFFLE_LOCATION.\nSupports `{github_run_id}` and `{github_run_attempt}` placeholders.\n", "required": false, "type": "string"}, "spicepod_path": {"description": "The spicepod file to test with (relative to test/spicepods/{query_set}/sf{scale_factor}/)", "required": true, "type": "string"}, "update_snapshots": {"default": "default", "description": "How to handle insta snapshot mismatches. `default` decides based on\nthe branch (release/* → no, anything else → always). `always` creates\nnew baselines on mismatch (use this on a brand-new spicepod that\nhas no snapshots yet). `no` fails on any drift, matching production\nbenchmark behavior. Mirrors `testoperator_run_bench.yml`.\n", "options": ["default", "always", "no"], "required": false, "type": "choice"}, "validate_results": {"default": false, "description": "Validate query results against expected (where supported)", "required": false, "type": "boolean"}}}}}, {"has_build_test_lint_hint": true, "jobs": ["seed-fixture", "cold-start"], "path": ".github/workflows/testoperator_run_cold_start.yml", "review": ["SECRET_REFERENCE"], "triggers": {"pull_request": {"paths": [".github/workflows/testoperator_run_cold_start.yml", ".github/actions/seed-cold-start-fixture/**", "test/spicepods/cold_start/**", "test/scripts/cold_start_delta_fixture.py", "tools/testoperator/src/commands/cold_start/**"]}, "schedule": [{"cron": "30 10 * * *"}], "workflow_dispatch": {"inputs": {"baseline_version": {"description": "Release tag to compare agains