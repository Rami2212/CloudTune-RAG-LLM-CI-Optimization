      "patch": "@@ -312,7 +312,7 @@ def hpre(content: str, escape: Optional[bool]=True, language: str=\"\") -> str:\n     :return: The formatted string.\r\n     :rtype: :obj:`str`\r\n     \"\"\"\r\n-    return '<pre><code class=\"{}\">{}</code></pre>'.format(language, escape_html(content) if escape else content)\r\n+    return '<pre><code class=\"{}\">{}</code></pre>'.format(escape_html(language), escape_html(content) if escape else content)\r\n \r\n \r\n def hide_link(url: str) -> str:\r",
      "raw_url": "https://github.com/ramitha1111/ct-scenario-0c06e7dd0279223c/raw/fd1fbb23881d159cad04df7ea2b86ce715a5c217/telebot%2Fformatting.py",
