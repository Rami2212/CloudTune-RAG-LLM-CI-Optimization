    {
      "additions": 37,
      "blob_url": "https://github.com/ramitha1111/ct-scenario-0c06e7dd0279223c/blob/fd1fbb23881d159cad04df7ea2b86ce715a5c217/tests%2Ftest_formatting.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/ramitha1111/ct-scenario-0c06e7dd0279223c/contents/tests%2Ftest_formatting.py?ref=fd1fbb23881d159cad04df7ea2b86ce715a5c217",
      "deletions": 0,
      "filename": "tests/test_formatting.py",
      "patch": "@@ -0,0 +1,37 @@\n+import sys\n+\n+sys.path.append('../')\n+\n+from html.parser import HTMLParser\n+\n+from telebot.formatting import hpre\n+\n+\n+class AttributeCollector(HTMLParser):\n+    def __init__(self):\n+        super().__init__()\n+        self.tags = []\n+\n+    def handle_starttag(self, tag, attrs):\n+        self.tags.append((tag, attrs))\n+\n+\n+def test_hpre_keeps_plain_language():\n+    assert hpre(\"x\", language=\"python\") == '<pre><code class=\"python\">x</code></pre>'\n+\n+\n+def test_hpre_escapes_quotes_in_language():\n+    assert hpre(\"x\", language='a\"b') == '<pre><code class=\"a&quot;b\">x</code></pre>'\n+\n+\n+def test_hpre_language_cannot_add_attributes():\n+    parser = AttributeCollector()\n+    parser.feed(hpre(\"x\", language='a\" onmouseover=\"alert(1)'))\n+    assert parser.tags == [\n+        (\"pre\", []),\n+        (\"code\", [(\"class\", 'a\" onmouseover=\"alert(1)')]),\n+    ]\n+\n+\n+def test_hpre_still_escapes_content():\n+    assert hpre(\"<b>\", language=\"python\") == '<pre><code class=\"python\">&lt;b&gt;</code></pre>'",
      "raw_url": "https://github.com/ramitha1111/ct-scenario-0c06e7dd0279223c/raw/fd1fbb23881d159cad04df7ea2b86ce715a5c217/tests%2Ftest_formatting.py",
      "sha": "eb0eabdfb5dca35a58828f0b3619dd92a66fc45b",
      "status": "added"
    }
