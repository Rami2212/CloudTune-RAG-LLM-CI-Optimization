{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtune.local/schemas/research-pattern.schema.json",
  "title": "CloudTune research pattern",
  "type": "object",
  "required": [
    "pattern_id",
    "title",
    "mechanism",
    "status"
  ],
  "properties": {
    "pattern_id": {
      "type": "string",
      "pattern": "^P-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "research_question": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contraindications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_type": {
      "enum": [
        "observational",
        "simulation_estimate",
        "controlled_execution",
        "guidance"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "year",
          "locator"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "expected_direction": {
      "type": "string"
    },
    "safety_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "extraction_status": {
      "const": "full_text_extracted"
    },
    "optimization_question": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "enum": [
        "workflow_yaml",
        "build_configuration",
        "ci_service",
        "research_only"
      ]
    },
    "success_status": {
      "enum": [
        "reported_benefit",
        "estimated_benefit",
        "mixed_results",
        "secondary_report_only",
        "no_direct_speedup_evidence"
      ]
    },
    "local_outcome": {
      "const": "not_evaluated"
    },
    "related_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P-[A-Z0-9-]+$"
      }
    },
    "reported_result": {
      "type": "object",
      "required": [
        "finding",
        "metrics",
        "pdf_pages",
        "locator"
      ],
      "properties": {
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object"
        },
        "pdf_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "required": [
        "origin",
        "format",
        "before_ref",
        "after_ref",
        "diff_ref",
        "source_before_ref",
        "source_after_ref",
        "source_diff_ref",
        "source_artifact_note",
        "before_sha256",
        "after_sha256",
        "diff_sha256"
      ],
      "properties": {
        "origin": {
          "const": "analyst_illustration_not_executed"
        },
        "format": {
          "const": "pseudocode"
        },
        "source_before_ref": {
          "type": "null"
        },
        "source_after_ref": {
          "type": "null"
        },
        "source_diff_ref": {
          "type": "null"
        },
        "source_artifact_note": {
          "type": "string",
          "minLength": 1
        },
        "before_ref": {
          "type": "string",
          "minLength": 1
        },
        "after_ref": {
          "type": "string",
          "minLength": 1
        },
        "diff_ref": {
          "type": "string",
          "minLength": 1
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "required": [
          "preconditions",
          "contraindications",
          "affected_checks",
          "implementation_notes",
          "evidence_type",
          "sources",
          "expected_direction",
          "safety_tests",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "extraction_status"
        ]
      },
      "then": {
        "required": [
          "paper_id",
          "optimization_question",
          "method",
          "scope",
          "success_status",
          "local_outcome",
          "reported_result",
          "example",
          "related_pattern_ids",
          "preconditions",
          "contraindications",
          "affected_checks",
          "implementation_notes",
          "evidence_type",
          "sources",
          "expected_direction",
          "safety_tests"
        ]
      }
    }
  ],
  "additionalProperties": false
}
