{
  "name": "@kortix/white-label-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The workbench kit shared by the apps/white-label reference apps: the snippet highlighter, the call-snippet panel and its model, the approvals view model, runtime recovery, the boot screen, the theme hook, the server-error body parser and the proxy's upstream-path guard.",
  "exports": {
    "./syntax-highlight": "./src/syntax-highlight.ts",
    "./api-error-body": "./src/api-error-body.ts",
    "./approvals-model": "./src/approvals-model.tsx",
    "./use-runtime-recovery": "./src/use-runtime-recovery.ts",
    "./boot-screen": "./src/boot-screen.tsx",
    "./call-snippet": "./src/call-snippet.tsx",
    "./call-snippets": "./src/call-snippets.ts",
    "./theme": "./src/theme.ts",
    "./upstream-path": "./src/upstream-path.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsgo.tsbuildinfo",
    "test": "node ../../scripts/test-guard.mjs \"bun test --timeout ${KORTIX_TEST_TIMEOUT_MS:-15000}\""
  },
  "dependencies": {
    "@kortix/sdk": "workspace:*",
    "@kortix/shared": "workspace:*",
    "@kortix/ui": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "^5.75.2",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "^21.0.4",
    "react-dom": "^19.1.0",
    "typescript": "^5"
  }
}
