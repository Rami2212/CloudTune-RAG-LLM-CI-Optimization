{
  "name": "histoire-example-quasar",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "story:dev": "node ../../scripts/dev-histoire.mjs",
    "story:build": "histoire build",
    "story:preview": "histoire preview --port 4567",
    "ci": "start-server-and-test story:preview http://localhost:4567/ test",
    "test": "cypress run",
    "test:dev": "cypress open --config baseUrl=http://localhost:6006",
    "test:examples": "pnpm run story:build && pnpm run ci"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.4",
    "quasar": "^2.24.0",
    "vue": "^3.5.26",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@histoire/plugin-quasar": "workspace:*",
    "@histoire/plugin-vue": "workspace:*",
    "@quasar/app-vite": "^3.10.3",
    "@typescript/native": "catalog:",
    "cypress": "^13.16.1",
    "histoire": "workspace:*",
    "quasar-app-extension-histoire-demo": "link:./app-extension",
    "start-server-and-test": "^2.0.8",
    "typescript": "catalog:"
  }
}
