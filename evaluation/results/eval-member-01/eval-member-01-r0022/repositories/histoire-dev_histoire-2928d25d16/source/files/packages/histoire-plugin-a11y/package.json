{
  "name": "@histoire/plugin-a11y",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Accessibility audits for Histoire with axe-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/histoire-dev/histoire.git",
    "directory": "packages/histoire-plugin-a11y"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && vite build && vue-tsc --emitDeclarationOnly && tsc -p tsconfig.node.json",
    "watch": "concurrently -k \"vite build --watch\" \"vue-tsc --emitDeclarationOnly --watch\" \"tsc -p tsconfig.node.json --watch\"",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@histoire/controls": "workspace:^",
    "histoire": "workspace:^",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@histoire/controls": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@histoire/plugin-kit": "workspace:^",
    "@histoire/protocol": "workspace:^",
    "@histoire/shared": "workspace:^",
    "axe-core": "4.14.0"
  },
  "devDependencies": {
    "@histoire/controls": "workspace:*",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.1.0",
    "histoire": "workspace:*",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "vue": "^3.5.26",
    "vue-tsc": "^3.3.13"
  }
}
