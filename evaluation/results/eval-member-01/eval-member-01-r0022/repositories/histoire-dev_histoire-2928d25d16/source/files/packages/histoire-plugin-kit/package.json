{
  "name": "@histoire/plugin-kit",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Contracts and helpers for Histoire workbench and frame plugins",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-plugin-kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./vue/mount": {
      "types": "./dist/vue/mount.d.ts",
      "default": "./dist/vue/mount.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./svelte4": {
      "types": "./dist/svelte4/index.d.ts",
      "default": "./dist/svelte4/index.js"
    },
    "./svelte5": {
      "types": "./dist/svelte5/index.d.ts",
      "default": "./dist/svelte5/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "vitest run && tsc -p tsconfig.test.json",
    "watch": "tsc -w --sourceMap"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "svelte": "^4.0.0 || ^5.7.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@histoire/protocol": "workspace:^",
    "@histoire/shared": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "catalog:",
    "jsdom": "^27.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.57.1",
    "svelte4": "npm:svelte@^4.2.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "vue": "^3.5.26"
  }
}
