{
  "name": "@histoire/app",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Pre-bundled UI for Histoire",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-app"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle-index.js"
    },
    "./sandbox": "./dist/bundled/sandbox.js",
    "./embed": {
      "types": "./dist/embed/source.d.ts",
      "default": "./dist/embed/source.js"
    },
    "./embed/capabilities": {
      "types": "./dist/embed/capabilities.d.ts",
      "default": "./dist/embed/capabilities.js"
    },
    "./*": "./*"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "rimraf dist && vite build && pnpm run build:embed && pnpm run build:css && node ./scripts/copy.mjs",
    "build:embed": "vite build --config vite.embed.config.ts && tsc -p tsconfig.embed.json",
    "build:css": "node ../../scripts/build-tailwind.mjs src/app/style/main.css ./dist/style.css",
    "watch": "concurrently \"vite build --watch\" \"vite build --config vite.embed.config.ts --watch\" \"tsc -p tsconfig.embed.json --watch\" \"pnpm run build:css --watch\" \"node ./scripts/watchAndCopy.mjs\""
  },
  "dependencies": {
    "@histoire/controls": "workspace:^",
    "@histoire/plugin-kit": "workspace:*",
    "@histoire/protocol": "workspace:^",
    "@histoire/sdk": "workspace:^",
    "@histoire/shared": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "@histoire/vue": "workspace:^",
    "fuse.js": "^7.0.0",
    "markdown-it": "^14.1.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/carbon": "^1.2.28",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "chokidar": "^4.0.1",
    "concurrently": "^9.1.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "pathe": "^1.1.2",
    "postcss": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "^3.5.26"
  }
}
