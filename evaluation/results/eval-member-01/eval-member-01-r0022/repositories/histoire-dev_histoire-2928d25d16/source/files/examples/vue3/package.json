{
  "name": "histoire-example-vue3",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:devframe": "node devframe/server.mjs",
    "test:devframe": "node --test devframe/example.test.mjs",
    "dev:hst": "node ../../scripts/dev-histoire.mjs --source",
    "story:dev": "node ../../scripts/dev-histoire.mjs",
    "story:build": "histoire build",
    "story:build:docs": "histoire build --config histoire.docs.config.ts",
    "story:preview": "histoire preview --port 4567",
    "ci": "start-server-and-test story:preview http://localhost:4567/ test",
    "test": "node ./cypress-parallel.mjs",
    "test:dev": "cypress open --config baseUrl=http://localhost:6006",
    "test:examples": "pnpm run story:build && pnpm run ci-s",
    "ci-s": "start-server-and-test story:preview http://localhost:4567/ test-s",
    "test-s": "cypress run --config baseUrl=http://localhost:4567"
  },
  "dependencies": {
    "lottie-web": "^5.12.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@histoire/app": "workspace:*",
    "@histoire/devframe": "workspace:*",
    "@histoire/plugin-a11y": "workspace:*",
    "@histoire/plugin-vue": "workspace:*",
    "@histoire/plugin-vue-devtools": "workspace:*",
    "@histoire/sdk": "workspace:*",
    "@histoire/vendors": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@typescript/native": "catalog:",
    "@vitejs/devtools": "0.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "4.1.10",
    "cypress": "^13.16.1",
    "devframe": "1.2.2",
    "globby": "^14.0.2",
    "histoire": "workspace:*",
    "histoire-example-plugin-reference": "workspace:*",
    "minimatch": "^10.0.1",
    "playwright": "^1.59.1",
    "sass": "^1.82.0",
    "start-server-and-test": "^2.0.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10"
  }
}
