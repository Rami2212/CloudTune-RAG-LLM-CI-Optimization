{
  "name": "@histoire/plugin-quasar",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Histoire plugin to integrate with Quasar CLI (Vite) projects",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-plugin-quasar"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/setup.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -d -p tsconfig.build.json",
    "watch": "tsc -d -w --sourceMap -p tsconfig.build.json",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "@histoire/plugin-vue": "workspace:^",
    "@quasar/app-vite": "^3.0.0",
    "histoire": "workspace:^",
    "quasar": "^2.16.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "workspace:*",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.10.1",
    "@typescript/native": "catalog:",
    "histoire": "workspace:*",
    "quasar": "^2.24.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "vue": "^3.5.26"
  }
}
