{
  "name": "@histoire/shared",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Shared utilities for Histoire",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./*",
    "./loading-delay": {
      "types": "./dist/loading-delay.d.ts",
      "default": "./dist/loading-delay.js"
    },
    "./inspection": {
      "types": "./dist/inspection/index.d.ts",
      "default": "./dist/inspection/index.js"
    },
    "./client-node": {
      "types": "./dist/client/server/run.d.ts",
      "default": "./dist/client/server/run.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "default": "./dist/accessibility/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && vite build && tsc --emitDeclarationOnly",
    "watch": "concurrently \"vite build --watch\" \"tsc -w --emitDeclarationOnly\""
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@histoire/protocol": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "chokidar": "^4.0.1",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "concurrently": "^9.1.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
