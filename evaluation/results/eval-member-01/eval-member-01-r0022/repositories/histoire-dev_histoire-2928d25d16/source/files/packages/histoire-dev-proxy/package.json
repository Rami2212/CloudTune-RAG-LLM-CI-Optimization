{
  "name": "@histoire/dev-proxy",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Early HTTP hosting and process lifecycle for Histoire development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akryum/histoire.git",
    "directory": "packages/histoire-dev-proxy"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc && vite build",
    "watch": "concurrently \"tsc -w\" \"vite build --watch\"",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "httpxy": "^0.1.7",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript/native": "catalog:",
    "concurrently": "^9.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10"
  }
}
