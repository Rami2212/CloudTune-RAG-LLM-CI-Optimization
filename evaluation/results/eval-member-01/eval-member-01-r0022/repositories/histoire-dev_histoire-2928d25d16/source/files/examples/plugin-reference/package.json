{
  "name": "histoire-example-plugin-reference",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Reference Histoire workbench plugin covering every contribution kind",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./client/vue": "./dist/client/vue.js",
    "./client/dom": "./dist/client/dom.js",
    "./client/react": "./dist/client/react.js",
    "./client/svelte": "./dist/client/svelte.js",
    "./client/svelte4": "./dist/client/svelte4.js",
    "./frame": "./dist/frame.js"
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@histoire/controls": "workspace:^",
    "histoire": "workspace:^",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@histoire/controls": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@histoire/plugin-kit": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@histoire/controls": "workspace:*",
    "@histoire/protocol": "workspace:*",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "histoire": "workspace:*",
    "jsdom": "^27.4.0",
    "svelte4": "npm:svelte@^4.2.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "vue": "^3.5.26"
  }
}
