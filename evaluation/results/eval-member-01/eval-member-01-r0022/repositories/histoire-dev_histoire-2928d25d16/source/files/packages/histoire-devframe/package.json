{
  "name": "@histoire/devframe",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Optional authenticated live inspection adapter for Histoire",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "default": "./dist/report/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@histoire/protocol": "workspace:^",
    "@histoire/sdk": "workspace:^",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "peerDependencies": {
    "devframe": "1.2.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@types/node": "^22.0.0",
    "devframe": "1.2.2",
    "typescript": "catalog:",
    "vitest": "4.1.10",
    "esbuild": "^0.27.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
