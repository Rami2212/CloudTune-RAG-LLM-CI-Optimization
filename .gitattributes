# Use LF for text in both the Git index and working tree on every platform.
# Auto detection preserves binary files and overrides core.autocrlf for text.
* text=auto eol=lf

# These generated datasets require exact LF bytes for integrity verification.
/evaluation/assignments/member_*.csv text eol=lf
/evaluation/assignments/manifest.json text eol=lf
/research-data/rag/rag_dataset.jsonl text eol=lf
/research-data/rag/rag_dataset.json text eol=lf
/research-data/rag/rag_dataset_manifest.json text eol=lf
