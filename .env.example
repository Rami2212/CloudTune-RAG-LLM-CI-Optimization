GITHUB_USERNAME=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=12000

# Supabase backend API access (never use a publishable key for ingestion).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternatively, use an older service-role key:
SUPABASE_SERVICE_ROLE_KEY=
# Table creation needs ONE of these in addition to API access:
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
# Optional when using a custom Supabase domain:
SUPABASE_PROJECT_REF=
