
# CloudTune local configuration
# Copy this file to .env and supply real credentials.
# Never commit .env or any real API keys.
# Nonempty exported environment variables override .env values.

# =============================================================================
# 1. GITHUB — Repository discovery and research-owned forks
# =============================================================================

# Required for pattern/scenario batch experiments.
GITHUB_USERNAME=

# Required for GitHub API access and fork operations.
# Fork creation, Actions execution and cleanup require appropriate permissions.
GITHUB_TOKEN=

# Optional alternative supported by some existing scripts.
# GH_TOKEN=

# Optional separate GitHub credential for evaluation/fork_pipeline.py.
# Takes precedence over GITHUB_TOKEN for fork evaluation.
# CLOUDTUNE_FORK_TOKEN=


# =============================================================================
# 2. OPENROUTER — LLM candidate generation
# =============================================================================

# Required for LLM optimization and Phase 3 generation/smoke verification.
OPENROUTER_API_KEY=

# Development batch runner model. Select a specific available :free model.
OPENROUTER_MODEL=

# Development batch runner token limit (256–48000).
OPENROUTER_MAX_TOKENS=24000

# NOTE:
# The evaluation pipeline pins its generator model, max_tokens and top_k in
# evaluation/configs/fork_pilot.json.
# OPENROUTER_MODEL and OPENROUTER_MAX_TOKENS do not override those settings.


# =============================================================================
# 3. SUPABASE — Frozen BGE-M3 RAG knowledge base
# =============================================================================

# Required for remote RAG verification, retrieval, and smoke generation.
# Use the existing populated CloudTune Supabase project.
SUPABASE_URL=

# Authorized server-side API key.
SUPABASE_SECRET_KEY=

# Alternative older service-role key; only one key is required.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: initial database setup and ingestion maintenance ONLY.
# Not required for normal read-only evaluation.
# SUPABASE_DB_URL=
# DATABASE_URL=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=


# =============================================================================
# 4. RAG — Local BGE-M3 inference
# =============================================================================

# cpu  = works without an NVIDIA GPU
# cuda = CUDA-enabled NVIDIA GPU with compatible PyTorch installed
#
# The committed evaluation/rag_retriever.py reads this setting.
# Keep the selected device fixed for reproducibility.
# Device provenance is not yet automatically persisted in evaluation results.
CLOUDTUNE_RAG_DEVICE=cpu

# Optional Hugging Face authentication for BGE-M3 downloads.
# Public models work without authentication.
# Recommended: authenticate once using `hf auth login`.
# HF_TOKEN=

# Optional Hugging Face cache location overrides.
# HF_HOME=
# HF_HUB_CACHE=


# =============================================================================
# 5. CI-COST — Optional tool installation override
# =============================================================================

# Leave commented to use the existing default installation location.
# Specify only a verified local ci-cost installation.
# CI_COST_DIR=


# =============================================================================
# 6. CONTROLLED SCENARIO EXPERIMENTS — Optional timing controls
# =============================================================================

# All values are in seconds.
SCENARIO_ABSENCE_SECONDS=120
SCENARIO_POLL_SECONDS=5
SCENARIO_WAIT_SECONDS=900
SCENARIO_WORK_SECONDS=90
